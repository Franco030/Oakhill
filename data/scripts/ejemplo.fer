func main() {
    var arbol = get_object("obj_1765498403553_511");

    var Tweener = get_system("TweenManager");
    print(Tweener);

    var contador = 10;

    while (contador > 0) {
        if (contador > 5) {
            Tweener.teleport(arbol, -100, -100, true);
        } else {
            Tweener.teleport(arbol, 100, 100, true);
        }
        contador = contador - 1;
    }
}